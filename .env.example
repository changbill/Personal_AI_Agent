# OLLAMA_HOST: Ollama 서버의 HTTP 주소
OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL: 명시적 Ollama 모델 태그 (latest 사용 금지)
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# OLLAMA_NUM_CTX: 요청당 사용할 Ollama context window 토큰 수
OLLAMA_NUM_CTX=2048
# AGENT_TIMEZONE: 일정·날짜 해석에 사용할 IANA 시간대 (기본값 Asia/Seoul)
AGENT_TIMEZONE=Asia/Seoul
# CALENDAR_MCP_URL: Google Calendar MCP 서버의 streamable HTTP 주소.
# 비워 두면 캘린더에 연결하지 않고 Schedule Agent가 도구 없이 답한다.
CALENDAR_MCP_URL=http://127.0.0.1:3000
# CALENDAR_ID: 조회·변경 대상 캘린더 식별자 (기본값 primary)
CALENDAR_ID=primary
